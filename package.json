{
  "name": "workclub",
  "version": "1.1.0",
  "private": true,
  "description": "Multi-tenant team collaboration and client-work management for agencies and freelance teams.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace backend",
    "dev:client": "npm run dev --workspace frontend",
    "dev:all": "concurrently -n api,web -c blue,magenta \"npm run dev\" \"npm run dev:client\"",
    "worker": "npm run worker --workspace backend",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "vercel-build": "npm run build",
    "lint": "eslint .",
    "test": "npm run test --workspace backend",
    "test:integration": "npm run test:integration --workspace backend",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm run test && npm run test:integration && npm run build",
    "setup": "npm run setup --workspace backend",
    "seed:demo": "npm run seed:demo --workspace backend"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.54.1",
    "concurrently": "^9.2.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "typescript-eslint": "^8.38.0"
  }
}
