NODE_ENV=development
PORT=8888
MONGO_URI=mongodb://127.0.0.1:27017/workclub
MONGO_MAX_POOL_SIZE=20
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=workclub_refresh
COOKIE_SECURE=false
REQUIRE_EMAIL_VERIFICATION=false
FRONTEND_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
TRUST_PROXY=false
LOG_LEVEL=info
METRICS_TOKEN=

# Use redis mode in production. With auto, Redis is used when REDIS_URL is present.
QUEUE_MODE=auto
REDIS_URL=redis://127.0.0.1:6379

# Initial owner used by `npm run setup`.
OWNER_NAME=WorkClub Owner
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change_this_password
WORKSPACE_NAME=My Workspace

# Optional email delivery. Set these for real invite emails.
# Example: create a Resend account and add your API key here.
RESEND_API_KEY=replace-with-your-resend-api-key
EMAIL_FROM=WorkClub <onboarding@yourdomain.com>
