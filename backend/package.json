{
  "name": "workclub-server",
  "version": "1.1.0",
  "private": true,
  "description": "WorkClub API for workspaces, projects, tasks, time, clients, proposals, and billing.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "setup": "tsx src/scripts/setup.ts",
    "seed:demo": "tsx src/scripts/seedDemo.ts",
    "db:indexes": "tsx src/scripts/syncIndexes.ts",
    "worker": "tsx watch src/worker.ts",
    "worker:start": "node dist/worker.js",
    "notifications": "tsx src/scripts/notificationSweep.ts",
    "test": "jest --runInBand --testPathIgnorePatterns=integration",
    "test:integration": "jest --runInBand --testPathPattern=integration",
    "test:coverage": "jest --runInBand --coverage",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.56.9",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.13.2",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "prom-client": "^15.1.3",
    "resend": "^4.2.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.8.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.14",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^29.7.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.2.6",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "mongodb-memory-server": "^8.14.0"
  }
}
